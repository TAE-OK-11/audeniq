{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "assets": {
    "binding": "ASSETS",
    "directory": "./public",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "compatibility_date": "2026-09-21",
  "d1_databases": [
    {
      "binding": "CONTENT_DB",
      "database_id": "401ad401-0a13-4059-8e9d-23298de21761",
      "database_name": "audeniq-content",
      "migrations_dir": "migrations"
    }
  ],
  "main": "./worker.js",
  "name": "audeniq-studio"
}
