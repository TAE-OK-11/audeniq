{
  "name": "audeniq-studio-app",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:api": "vite --mode edge --port 5173 --strictPort",
    "build": "tsc --noEmit && vite build --mode edge --outDir ../public",
    "build:edge": "tsc --noEmit && vite build --mode edge",
    "preview": "vite preview",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "preview:api": "vite preview --mode edge --port 5173 --strictPort",
    "e2e": "bun e2e/smoke.ts",
    "build:demo": "tsc --noEmit && vite build --outDir ../demo-dist"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^30.1.1",
    "playwright": "1.56.1",
    "postcss": "^8.5.28",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
