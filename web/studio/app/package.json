{
  "name": "audeniq-studio-app",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:api": "vite --mode edge --port 5173 --strictPort",
    "build": "tsc --noEmit && vite build --mode edge --outDir ../public && node --experimental-strip-types ../../shared/compress-assets.ts ../public",
    "build:edge": "tsc --noEmit && vite build --mode edge && node --experimental-strip-types ../../shared/compress-assets.ts ../edge-dist",
    "preview": "vite preview",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "preview:api": "vite preview --mode edge --port 5173 --strictPort",
    "e2e": "bun e2e/smoke.ts",
    "e2e:application": "bun e2e/application-rights.ts",
    "audit:ui": "bun e2e/ui-audit.ts",
    "build:demo": "tsc --noEmit && vite build --outDir ../demo-dist"
  },
  "dependencies": {
    "@tiptap/core": "3.32.1",
    "@tiptap/extension-details": "3.32.1",
    "@tiptap/extension-list": "3.32.1",
    "@tiptap/extension-table": "3.32.1",
    "@tiptap/extensions": "3.32.1",
    "@tiptap/pm": "3.32.1",
    "@tiptap/react": "3.32.1",
    "@tiptap/starter-kit": "3.32.1",
    "@tiptap/suggestion": "3.32.1",
    "qrcode-generator": "1.4.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.2",
    "playwright": "1.64.0",
    "postcss": "^8.5.32",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
