{
  "partner_id": "D-7",
  "adapter": "ddex",
  "transport": {
    "kind": "s3",
    "endpoint": "https://REPLACE-with-partner-s3-endpoint",
    "region": "us-east-1",
    "bucket": "REPLACE-with-partner-bucket",
    "prefix": "REPLACE-with-assigned-prefix",
    "access_key_id": {"file": "/etc/audeniq/partners/secrets/D-7.access_key_id"},
    "secret_access_key": {"file": "/etc/audeniq/partners/secrets/D-7.secret_access_key"}
  },
  "ddex": {
    "choreography": "release_by_release",
    "ack_dir": "acks",
    "live_policy": "on_ack"
  },
  "webhook": {
    "secret": {"file": "/etc/audeniq/partners/secrets/D-7.webhook_secret"},
    "signature_header": "X-Signature",
    "timestamp_header": "X-Timestamp",
    "max_skew_secs": 300
  }
}
