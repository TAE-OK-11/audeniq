# Copy to deploy/production.env (ignored); chmod 600. Never reuse development credentials.
# DB passwords below must be URL-safe because DATABASE_URL embeds them.
# deploy.sh가 배포할 때마다 이 줄을 GHCR digest로 바꾼다 (Actions 'Backend image' 요약에 나오는 값)
AUDENIQ_IMAGE=ghcr.io/tae-ok-11/audeniq@sha256:REPLACE_WITH_VERIFIED_DIGEST
# 공용 manifest는 amd64+arm64. Graviton4 최적화는 sha-<commit>-graviton4, Oracle Cloud Ampere A1은
# sha-<commit>-ampere-a1 태그의 digest. CPU별 이미지·서버 자원: deploy/GRAVITON4.md, Oracle Cloud: deploy/ORACLE_CLOUD.md
# ARM 서버에서는 cloudflared digest도 ARM64를 포함해야 한다.
CLOUDFLARED_IMAGE=cloudflare/cloudflared@sha256:REPLACE_WITH_TESTED_DIGEST
# Optional secret manager (AWS Secrets Manager / GCP Secret Manager / OCI Vault):
# `audeniq-secrets secrets materialize` writes these secrets into host tmpfs.
# When set, deploy.sh reads this file after production.env, so the same names
# there are overridden and can be removed from this file. docs/SECRET_MANAGER.md
SECRETS_ENV_FILE=
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_OWNER_PASSWORD
API_DB_PASSWORD=REPLACE_WITH_RANDOM_API_PASSWORD
WORKER_DB_PASSWORD=REPLACE_WITH_RANDOM_WORKER_PASSWORD
EDGE_SERVICE_SECRET=REPLACE_WITH_RANDOM_SECRET_SHARED_WITH_EDGE
# Worker(EDGE_SERVICE_SECRET secret)가 /api 요청에 x-audeniq-service 헤더로 붙인다
# Optional cloud KMS is disabled by default. Enable and set the file only
# after materializing the keyring in host tmpfs; API mounts it read-only.
PAYOUT_KMS_ENABLED=false
PAYOUT_KEYRING_FILE=
# KMS-off mode can use a private local keyring or the existing 64-hex AES key.
# The same key seals emails, names and contacts (docs/PII_ENCRYPTION.md), so
# production requires one: KMS mode (recommended) or this key.
PAYOUT_ACCOUNT_KEY=
# audeniq-secrets kms supports AWS KMS, GCP Cloud KMS and OCI Vault (--provider aws|gcp|oci).
# Provider IDs/cloud credentials belong to the host materializer, not containers.
# KMS mode uses the materialized file; local AES keys must stay private and unlogged.
PAYOUT_KEYRING_DIR=/dev/shm/audeniq-secrets
# backup.sh reads this PUBLIC age recipient file. Keep private identity off-server.
BACKUP_RECIPIENTS_FILE=/opt/audeniq/backup-recipients.txt
APP_ORIGIN=https://studio.audeniq.com
# 화면별 규칙 (crates/core/src/sites.rs) — Worker가 x-audeniq-site(studio|admin)를 붙인다
# 관리자 콘솔 주소. 비우면 관리자 화면의 쓰기 요청은 403.
ADMIN_ORIGIN=https://admin.audeniq.com
# 패스키(WebAuthn) RP ID: 스튜디오·관리자 주소의 공통 상위 도메인이면 한 패스키를 두 곳에서 쓴다.
# 비우면 APP_ORIGIN 호스트(스튜디오에서만 동작). 한 번 정하면 바꾸지 않는다(바꾸면 등록한 패스키가 모두 쓸 수 없게 된다).
PASSKEY_RP_ID=audeniq.com
# 스태프 2단계 인증(TOTP). 개발 중에는 false, 실제 운영 시작 전에 true로 (docs/AUTH_SECURITY.md)
STAFF_MFA_REQUIRED=false
# Google·Apple 로그인 (docs/SOCIAL_LOGIN.md). 값이 모두 있는 제공자만 로그인 화면에 버튼이 보인다.
# 비밀 값(CLIENT_SECRET, PRIVATE_KEY)은 이 파일 대신 시크릿 매니저(SECRETS_ENV_FILE)에 두는 것을 권장한다.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Apple: Services ID, 팀 ID(10자), Sign in with Apple 키 ID, 그 키의 .p8 내용(줄바꿈은 \n)
APPLE_OAUTH_CLIENT_ID=
APPLE_OAUTH_TEAM_ID=
APPLE_OAUTH_KEY_ID=
APPLE_OAUTH_PRIVATE_KEY=
# 공지·점검 비상 도구용 Bearer 토큰 (32자 이상, 비우면 끔)
CONTENT_ADMIN_TOKEN=
# 비상 점검 스위치: on이면 모든 일반 API가 503 (바꾼 뒤 api 재시작). 선택: MAINTENANCE_TITLE/MESSAGE/UNTIL
MAINTENANCE_MODE=
STORAGE_ENABLED=false
# Optional persistent antivirus is disabled by default; normalization remains on.
UPLOAD_AV_ENABLED=false
# With antivirus enabled, initialize official definitions and measure >=8GiB RAM.
AV_MEM_LIMIT=3g
AV_UPDATE_MEM_LIMIT=1536m
AV_CPUS=0.75
# 업로드 저장소 (docs/STORAGE_PROVIDERS.md). 주소로 사업자를 판별한다:
#   Cloudflare R2  https://<계정>.r2.cloudflarestorage.com
#   AWS S3         https://s3.ap-northeast-2.amazonaws.com
#   Oracle Cloud   https://<네임스페이스>.compat.objectstorage.ap-seoul-1.oraclecloud.com
# S3_REGION=auto면 AWS·OCI는 주소의 리전으로 서명한다. 설정 후 `audeniq-admin storage probe --origin …`로 점검.
S3_ENDPOINT=https://unconfigured.invalid
S3_BUCKET=unconfigured
S3_REGION=auto
# R2 API 토큰 (버킷 하나로 범위 제한). 서버에만 있고 사용자에게는 절대 가지 않는다:
# 사용자는 10분짜리 서명 URL로 격리 경로에 파일 하나만 올린다.
# API: Object Read & Write
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# worker: Object Read only (비우면 위 API 토큰을 쓴다)
S3_WORKER_ACCESS_KEY_ID=
S3_WORKER_SECRET_ACCESS_KEY=

# 원본 문서 보관 버킷 (docs/DOCUMENT_ARCHIVE.md, deploy/archive.sh). 비우면 보관·고정(anchor) 안 함.
# AWS S3·R2·Oracle Cloud 모두 된다(docs/STORAGE_PROVIDERS.md). 점검: audeniq-admin storage probe --archive
# 작업 버킷과 다른 버킷·다른 자격증명(가능하면 다른 사업자/리전). API 컨테이너에는 넘기지 않고
# archive.sh가 실행할 때만 쓴다 — 비밀 값은 SECRETS_ENV_FILE에 두는 것을 권장.
ARCHIVE_S3_ENDPOINT=
ARCHIVE_S3_BUCKET=
ARCHIVE_S3_REGION=auto
# 쓰기 + 읽기만 (삭제 권한은 purge를 돌리는 경우에만)
ARCHIVE_S3_ACCESS_KEY_ID=
ARCHIVE_S3_SECRET_ACCESS_KEY=
# AWS S3 Object Lock(COMPLIANCE) 버킷이면 true — 객체마다 보존기한을 건다.
# R2는 false로 두고 버킷 잠금 규칙(Bucket Lock), Oracle Cloud는 false로 두고 보존 규칙(Retention rule)으로 보존한다.
ARCHIVE_OBJECT_LOCK=false
# PITR용 WAL 보관 (on이면 archive.sh wal을 cron에 등록). 바꾼 뒤 postgres 재시작
PG_ARCHIVE_MODE=off

# DDEX message sender = the distributor's party id (issued by DDEX, PADPIDA…).
# Used for every artist org that has no DPID of its own. Empty: no real ERN is
# generated (staging shows DSP_SENDER_DPID_MISSING).
DDEX_SENDER_DPID=
DDEX_SENDER_NAME=AUDENIQ

# 공식 오픈 전 실DSP 전송 잠금. 비워 두면(기본) 실제 DSP로는 어떤 요청도 나가지 않는다:
# 계약된 DSP도 라우팅되지 않고(PRE_LAUNCH_LOCKED), SFTP/S3/API 클라이언트는 외부 호스트 접속을 거부한다.
# 공식 오픈 때만 enabled 로 바꾼다 (docs/PARTNER_DELIVERY.md 0절).
DSP_LIVE_TRANSMISSION=

# 스튜디오 테스트 플랫폼 "MockDSP (테스트)" (서버 안의 가짜 DSP, 외부로 아무것도 안 나감).
# 비워 두면 위 잠금이 닫혀 있는 동안(공식 오픈 전)만 스튜디오 플랫폼 목록에 나온다.
# enabled: 오픈 후에도 표시, disabled: 숨김 (docs/PARTNER_DELIVERY.md 0-3절).
MOCKDSP_STUDIO=

# Media capacity per API/worker process; empty = available CPUs, bounded 1–8.
# Set with WORKER_CPUS/QUEUE_QC_CONCURRENCY when scaling beyond the 1-vCPU defaults.
AUDENIQ_QC_ASSET_PARALLELISM=
# Address-space limit of each audio parser child (512–1024 MiB), not an RSS limit.
AUDENIQ_AUDIO_PARSER_MEMORY_MIB=768
