# Development only. Use independent random URL-safe passwords; do not commit .env.
POSTGRES_PASSWORD=
API_DB_PASSWORD=
WORKER_DB_PASSWORD=
EDGE_SERVICE_SECRET=
APP_ENV=development
APP_ORIGIN=http://localhost:5173
API_BIND=127.0.0.1:8080
DATABASE_URL=postgres://audeniq_api:REPLACE@127.0.0.1:5432/audeniq_dev
STORAGE_ENABLED=false
S3_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
S3_BUCKET=audeniq-private-dev
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
RUST_LOG=info
WORKER_MAX_IN_FLIGHT=3
DATABASE_MAX_CONNECTIONS=8
JOB_LEASE_SECONDS=300
QUEUE_INTERACTIVE_CONCURRENCY=1
QUEUE_QC_CONCURRENCY=1
QUEUE_RIGHTS_CONCURRENCY=1
QUEUE_DISTRIBUTION_CONCURRENCY=1
QUEUE_FINANCE_CONCURRENCY=1
QUEUE_DELIVERY_CONCURRENCY=2
